# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unrooted: covers repo root and every workspace under apps/, packages/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/

# next.js
.next/
out/

# expo
.expo/
.expo-export-check/
expo-env.d.ts

# production
/build
apps/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# claude code & ruflo local state (all except example config)
.claude/
.claude-flow/
.playwright-mcp/
.swarm/
claude-flow.config.json
agentdb.rvf*
ruvector.db*
data/
DONOTREAD.md
tsconfig.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product spec kept out of the public repo (shared out-of-band; lives locally only)
docs/SPEC.md

# internal strategy docs (pricing/booking model, roadmaps) — never public
docs/internal/

# project-level claude instructions (local only)
CLAUDE.local.md

# ruflo (claude-flow) — installed locally, runtime kept out of the repo
# (.claude/ itself is already blanket-ignored above; these lines are kept as
# an explicit record of what ruflo's init writes, plus .agents/, which is a
# separate top-level dir not covered by the .claude/ rule)
.claude-flow/
.swarm/
.agents/
.claude/settings.json
.claude/proven-config.json
.claude/.proven-config-version
.claude/agents/
.claude/commands/
.claude/helpers/
# ruflo-added skills (the tracked project skills are unaffected)
.claude/skills/agentdb-*/
.claude/skills/reasoningbank-*/
.claude/skills/v3-*/
.claude/skills/swarm-advanced/
.claude/skills/swarm-orchestration/
.claude/skills/github-code-review/
.claude/skills/github-multi-repo/
.claude/skills/github-project-management/
.claude/skills/github-release-management/
.claude/skills/github-workflow-automation/
.claude/skills/browser/
.claude/skills/hooks-automation/
.claude/skills/pair-programming/
.claude/skills/skill-builder/
.claude/skills/sparc-methodology/
.claude/skills/stream-chain/
.claude/skills/verification-quality/
.claude/skills/ruflo
