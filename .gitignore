# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored: applies in apps/* and packages/* too)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/

# next.js
.next/
out/

# production build output
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# personal claude code settings
.claude/settings.local.json

# ruflo/claude-flow local tooling state (regenerates via active MCP daemon)
.claude-flow/
.swarm/
ruvector.db
claude-flow.config.json
/data/
.claude/memory.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product spec kept out of the public repo (shared out-of-band; lives locally only)
docs/SPEC.md

# internal strategy docs (pricing/booking model, roadmaps) — never public
docs/internal/
