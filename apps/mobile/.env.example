# Mobile app environment. Copy to .env and fill in from apps/web/.env.local:
# EXPO_PUBLIC_* vars are BUNDLED INTO THE APP and must only ever hold
# public-safe values (URL + anon key). Never put service-role or Stripe
# secret keys here - the app has no privileged keys by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
