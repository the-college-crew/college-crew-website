# College Crew — required environment variables.
# Copy to .env.local and fill in real values (shared out-of-band, never committed).

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — TEST MODE ONLY for the pilot. Account not provisioned yet;
# payment code stays behind lib/stripe/ seams until these exist.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email (provider .edu verification codes). Not
# provisioned yet: with RESEND_API_KEY unset, the OTP is logged server-side
# instead of emailed, so the flow is fully testable in dev. EMAIL_FROM must be
# a verified sending identity on your Resend domain once live. The verified
# Resend domain for this project is send.thecollegecrew.com.
RESEND_API_KEY=
EMAIL_FROM="College Crew <no-reply@send.thecollegecrew.com>"

# OpenAI — powers the gpt-5.4-nano scan of provider bios and display names
# (lib/moderation/profile-text.ts). Optional: with it unset, that layer no-ops
# and the regex layer stands alone. Profile moderation is flag-only, so a missing
# key never stops a provider from saving.
#
# NOTE: this is the APP's copy of the key, read from .env.local (and Vercel).
# The moderate-message Edge Function has its OWN OPENAI_API_KEY in the Supabase
# secret store — see below. Setting one does not set the other.
OPENAI_API_KEY=

# Hourly Booking v1 rollout controls. Both are server-side and default to false
# when omitted. Request creation may be enabled independently only during a
# coordinated rollout; existing booking dashboards/actions remain available.
HOURLY_BOOKING_ENABLED=false
BOOKING_REQUESTS_ENABLED=false

# ── Edge Function secrets (moderate-message) ────────────────────────────────
# These are NOT read from .env.local — they live in the Supabase Edge Function
# secret store and are set with `npx supabase secrets set NAME=value`, then a
# redeploy (`npx supabase functions deploy moderate-message`). Listed here for
# reference only.
#   OPENAI_API_KEY   — enables the gpt-5.4-nano contact-info scan (Layer 2).
#                      Unset → the function no-ops the model pass; regex stands
#                      alone. Never blocks a message on an OpenAI outage.
#   RESEND_API_KEY   — lets the function email founders when a message is
#                      flagged. Unset → it logs the notice instead of sending.
#   EMAIL_FROM       — sender identity for that notification (same verified
#                      Resend domain as above).
